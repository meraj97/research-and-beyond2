{
  "name": "research-and-beyond",
  "version": "2.0.0",
  "private": true,
  "description": "Research and Beyond — bilingual (Bangla/English) single-page funnel website with dark/light themes and an admin panel (Next.js + PostgreSQL)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "setup": "npm run db:migrate && npm run db:seed && npm run admin:create"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0"
  }
}
